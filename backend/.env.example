# ---------------------------------------------------------------------------
# Oaziland — Environment Variable Template
#
# HOW TO USE THIS FILE: copy it to a new file named exactly ".env" in this
# same folder, then fill in real values. ".env" is deliberately excluded
# from Git (see .gitignore) so real secrets never get committed to the
# repository. This file (".env.example") only ever holds placeholders —
# it is safe to commit and share.
# ---------------------------------------------------------------------------

# --- Core Django settings ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Only used when DEBUG=False — comma-separated list of the real deployed
# frontend domain(s), e.g. https://oaziland.com,https://www.oaziland.com
CORS_ALLOWED_ORIGINS=
# The backend's own reachable origin — turns a locally-stored upload's
# relative URL into an absolute one the frontend (a different origin
# in dev) can load. In production, set to the real deployed API domain.
BACKEND_BASE_URL=http://localhost:8000

# --- Database (Prompt 1) ---
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://oaziland_dev:dev_password_change_me@localhost:5432/oaziland_dev

# --- Redis (Prompt 5 — booking locks, background jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication (Prompt 2) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# --- SMS / MFA (Prompt 2) ---
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
# (or, if using Twilio instead:)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- KYC (Prompt 2) ---
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

# --- Payments (Prompt 5 & Cameroon Market Payouts) ---
# Active payment gateway: SANDBOX, FAPSHI, CINETPAY, MONETBIL, FLUTTERWAVE
PAYMENT_GATEWAY_PROVIDER=FAPSHI

# Fapshi (Official Cameroon Gateway: MTN Mobile Money, Orange Money, Direct Pay & Payouts)
# Documentation: https://docs.fapshi.com/en/api-reference/getting-started
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://sandbox.fapshi.com
# Never enable in production. Automated tests already use SandboxGateway directly.
FAPSHI_ALLOW_TEST_FALLBACK=False

# Alternative gateways:
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
MONETBIL_SERVICE_KEY=
FLUTTERWAVE_API_KEY=

# --- Media Storage (Prompt 7) ---
# LOCAL works today with zero external account (correct for
# development). Set to CLOUDINARY once real credentials below exist.
MEDIA_STORAGE_PROVIDER=LOCAL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI Moderation (Prompt 9) ---
OPENAI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# --- AI Support Chatbot (Prompt 21 companion — engagement.support_agent) ---
# Active provider: SANDBOX (default, deterministic FAQ stand-in) or OPENROUTER
SUPPORT_AGENT_PROVIDER=SANDBOX
# Get a key at https://openrouter.ai/keys — required when SUPPORT_AGENT_PROVIDER=OPENROUTER
OPENROUTER_API_KEY=
# A :free-suffixed model needs no payment method/credits — switch to a paid
# model (e.g. openai/gpt-4o-mini) once your OpenRouter account has credits.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Comma-separated models to try if the primary one is congested (OpenRouter's
# :free models share a per-provider capacity pool across ALL of its users,
# so a single free model returning 429 is common and transient).
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free

# --- WhatsApp / Email notifications (Prompt 19) ---
# Meta WhatsApp Cloud API. The template is optional for messages sent inside
# the 24-hour customer-service window, but proactive notifications require an
# approved template whose body accepts the message as its first parameter.
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Postmark transactional email. POSTMARK_FROM_EMAIL must be a verified sender.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# --- Error Tracking (Prompt 21) ---
SENTRY_DSN=
